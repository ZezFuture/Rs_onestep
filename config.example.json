{
  "sd21": "stabilityai/stable-diffusion-2-1-base",
  "taesd": "madebyollin/taesd",
  "siglip2": "google/siglip2-so400m-patch16-512",
  "reward_checkpoint": null,
  "train_dir": "data/train_hr",
  "output_dir": "runs/rs_onestep",
  "resolution": 512,
  "prompt": "high quality, sharp, detailed image",
  "batch_size": 16,
  "target_global_batch_size": 192,
  "grad_accum_steps": null,
  "num_workers": 4,
  "max_epochs": 100,
  "max_steps": 50000,
  "save_every": 2000,
  "log_every": 10,
  "loss_window_size": 100,
  "eval_freq": 500,
  "precision": "bf16",
  "allow_tf32": true,
  "report_to": "tensorboard",
  "lr_scheduler": "constant_with_warmup",
  "lr_warmup_steps": 500,
  "lr_scheduler_d": "constant_with_warmup",
  "lr_warmup_steps_d": 500,
  "seed": 1234,
  "lora_rank": 64,
  "lora_alpha": 128,
  "lora_dropout": 0.0,
  "lora_modules": ["to_k", "to_q", "to_v", "to_out.0", "conv", "conv1", "conv2", "conv_shortcut", "conv_out", "proj_in", "proj_out", "ff.net.2", "ff.net.0.proj"],
  "lr_lora": 0.00005,
  "lr_encoder": 0.00005,
  "lr_discriminator": 0.00001,
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "adam_epsilon": 1e-8,
  "weight_decay": 0.01,
  "max_grad_norm": 1.0,
  "clean_loss_weight": 1.0,
  "lpips_loss_weight": 2.0,
  "lpips_net": "vgg",
  "gan_weight": 0.05,
  "wrong_lr_weight": 0.25,
  "score_l2_weight": 0.0001,
  "discriminator": {
    "image_size": 512,
    "use_pooler": true,
    "hidden_layers": [-1, -4],
    "token_pool_size": 8,
    "attn_dim": 256,
    "num_heads": 4,
    "num_fusion_layers": 1,
    "sr_quality_layers": 1,
    "use_fidelity_branch": true,
    "use_sr_quality_branch": true,
    "head_hidden_dim": 512,
    "dropout": 0.1,
    "normalize_global_feature": true
  }
}


